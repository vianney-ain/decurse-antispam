msgstr "의심스러운 패턴"

msgid "Foreign spam"
msgstr "외국어 스팸"

msgid "protects your WordPress comments from spam using multiple layered detection techniques."
msgstr "다층 감지 기술을 사용하여 WordPress 댓글을 스팸으로부터 보호합니다."

msgid "Protection Techniques"
msgstr "보호 기술"

msgid "Invisible trap field that bots fill out automatically"
msgstr "봇이 자동으로 채우는 보이지 않는 함정 필드"

msgid "Time Check"
msgstr "시간 확인"

msgid "Blocks submissions faster than humanly possible"
msgstr "인간적으로 불가능한 속도의 제출 차단"

msgid "Detects spam domains, bot phrases, and suspicious patterns"
msgstr "스팸 도메인, 봇 문구 및 의심스러운 패턴 감지"

msgid "Why Decurse Antispam?"
msgstr "왜 Decurse 스팸방지인가?"

msgid "No external API - All processing happens on your server"
msgstr "외부 API 없음 - 모든 처리는 서버에서 이루어집니다"

msgid "No CAPTCHA - Invisible to your visitors"
msgstr "CAPTCHA 없음 - 방문자에게 보이지 않음"

msgid "Privacy-friendly - No data sent to third parties"
msgstr "개인 정보 보호 - 제3자에게 데이터 전송 없음"

msgid "Lightweight - Minimal impact on page load"
msgstr "경량 - 페이지 로드에 최소한의 영향"

msgid "Upload the <code>decurse-antispam</code> folder to <code>/wp-content/plugins/</code>"
msgstr "<code>decurse-antispam</code> 폴더를 <code>/wp-content/plugins/</code>에 업로드"

msgid "Activate the plugin through the \"Plugins\" menu in WordPress"
msgstr "WordPress의 \"플러그인\" 메뉴를 통해 플러그인 활성화"

msgid "Go to <strong>Decurse</strong> in the admin menu to configure settings"
msgstr "관리자 메뉴에서 <strong>Decurse</strong>로 이동하여 설정 구성"

msgid "Initial release"
msgstr "초기 릴리스"

msgid "Honeypot protection"
msgstr "허니팟 보호"

msgid "Time-based submission check"
msgstr "시간 기반 제출 확인"

msgid "JavaScript token validation"
msgstr "JavaScript 토큰 유효성 검사"

msgid "Content analysis with multiple detection methods"
msgstr "다중 감지 방법을 통한 콘텐츠 분석"

msgid "Dashboard with statistics and logs"
msgstr "통계 및 로그가 있는 대시보드"

msgid "Configurable blacklists"
msgstr "구성 가능한 블랙리스트"

msgid "Comment spam protection for WordPress. No external API required."
msgstr "WordPress용 댓글 스팸 보호. 외부 API 필요 없음."

msgid "More information about Decurse Antispam"
msgstr "Decurse 스팸방지에 대한 자세한 정보"

# Tests tab - v1.0.1
msgid "Tests"
msgstr "테스트"

msgid "Tester la détection anti-spam"
msgstr "스팸 감지 테스트"

msgid "Lancez des tests pour vérifier que la détection anti-spam fonctionne correctement avec vos paramètres actuels."
msgstr "현재 설정으로 스팸 감지가 올바르게 작동하는지 테스트를 실행합니다."

msgid "Sélectionnez les tests à lancer"
msgstr "실행할 테스트 선택"

msgid "Désactivé dans les paramètres"
msgstr "설정에서 비활성화됨"

msgid "Piège avec champ invisible"
msgstr "보이지 않는 필드 함정"

msgid "Vérification du temps"
msgstr "시간 확인"

msgid "Min. %d secondes"
msgstr "최소 %d초"

msgid "Jeton JavaScript"
msgstr "JavaScript 토큰"

msgid "Validation JS"
msgstr "JS 검증"

msgid "Analyse du contenu"
msgstr "콘텐츠 분석"

msgid "Domaines, motifs, liens"
msgstr "도메인, 패턴, 링크"

msgid "Lancer les tests"
msgstr "테스트 실행"

msgid "Résultats"
msgstr "결과"

msgid "Honeypot - Spam (champ rempli)"
msgstr "허니팟 - 스팸 (필드 채움)"

msgid "Le bot remplit le champ honeypot caché"
msgstr "봇이 숨겨진 허니팟 필드를 채움"

msgid "Honeypot - Valide (champ vide)"
msgstr "허니팟 - 유효 (필드 비움)"

msgid "L'humain laisse le champ honeypot vide"
msgstr "사람은 허니팟 필드를 비워둠"

msgid "Temps - Spam (trop rapide)"
msgstr "시간 - 스팸 (너무 빠름)"

msgid "Soumission en 1s (min: %ds)"
msgstr "1초 내 제출 (최소: %d초)"

msgid "Temps - Valide (vitesse normale)"
msgstr "시간 - 유효 (정상 속도)"

msgid "Soumission en 10s (min: %ds)"
msgstr "10초 내 제출 (최소: %d초)"

msgid "Jeton JS - Spam (jeton invalide)"
msgstr "JS 토큰 - 스팸 (잘못된 토큰)"

msgid "Le bot envoie un jeton invalide ou vide"
msgstr "봇이 잘못된 또는 빈 토큰 전송"

msgid "Jeton JS - Valide (jeton correct)"
msgstr "JS 토큰 - 유효 (올바른 토큰)"

msgid "Le navigateur génère le jeton MD5 correct"
msgstr "브라우저가 올바른 MD5 토큰 생성"

msgid "Contenu - Domaine spam"
msgstr "콘텐츠 - 스팸 도메인"

msgid "Le commentaire contient binance.com"
msgstr "댓글에 binance.com 포함"

msgid "Contenu - Phrase de bot"
msgstr "콘텐츠 - 봇 문구"

msgid "Commentaire générique de bot détecté"
msgstr "일반적인 봇 댓글 감지됨"

msgid "Contenu - Motif spam"
msgstr "콘텐츠 - 스팸 패턴"

msgid "Contient le motif \"easy $500\""
msgstr "패턴 \"easy $500\" 포함"

msgid "Contenu - Email suspect"
msgstr "콘텐츠 - 의심스러운 이메일"

msgid "Email : 12345678@outlook.com"
msgstr "이메일: 12345678@outlook.com"

msgid "Contenu - Trop de liens"
msgstr "콘텐츠 - 링크 너무 많음"

msgid "Le commentaire a 5 liens (max: %d)"
msgstr "댓글에 링크 5개 (최대: %d)"

msgid "Contenu - Commentaire valide"
msgstr "콘텐츠 - 유효한 댓글"

msgid "Commentaire légitime sans indicateurs de spam"
msgstr "스팸 지표 없는 정상 댓글"

msgid "Test inconnu"
msgstr "알 수 없는 테스트"

msgid "Type de test non reconnu"
msgstr "테스트 유형 인식 불가"

msgid "Désactiver Decurse Antispam"
msgstr "Decurse 스팸방지 비활성화"

msgid "Si vous prévoyez de supprimer le plugin, voulez-vous conserver ou supprimer les données ?"
msgstr "플러그인을 삭제하려면 데이터를 유지하시겠습니까, 삭제하시겠습니까?"

msgid "Conserver les données"
msgstr "데이터 유지"

msgid "Les paramètres, statistiques et logs seront conservés. Vous pourrez réinstaller le plugin sans perdre de données."
msgstr "설정, 통계 및 로그가 유지됩니다. 데이터 손실 없이 플러그인을 다시 설치할 수 있습니다."

msgid "Supprimer les données à la désinstallation"
msgstr "제거 시 데이터 삭제"

msgid "Lors de la suppression du plugin, supprimer définitivement tous les paramètres, statistiques et logs de la base de données."
msgstr "플러그인 삭제 시 모든 설정, 통계 및 로그를 데이터베이스에서 영구 삭제합니다."

msgid "Annuler"
msgstr "취소"

msgid "Désactiver"
msgstr "비활성화"

msgid "Traitement..."
msgstr "처리 중..."

msgid "Avancé"
msgstr "고급"

msgid "Supprimer toutes les données du plugin (statistiques, logs, paramètres) lors de la suppression"
msgstr "삭제 시 모든 플러그인 데이터(통계, 로그, 설정) 삭제"

msgid "Enregistrer"
msgstr "저장"
